{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "outDir": "out/main",
    "skipLibCheck": true,
    "composite": true
  },
  "include": ["src/main/**/*"]
}
