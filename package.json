{
  "name": "shega-desktop",
  "version": "1.0.0",
  "description": "Shega - Offline Inventory & Sales Management System",
  "author": "shega",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-builder --win",
    "test:sync": "node e2e-sync-run.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "i18n:audit": "node scripts/i18n-audit.js",
    "i18n:audit:ci": "node scripts/i18n-audit.js --output=./i18n-audit-report.json || true",
    "security:audit": "npm audit --audit-level=moderate",
    "security:osv": "osv-scanner --config=.osv-scanner.toml ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@serialport/parser-delimiter": "^13.0.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.11.0",
    "better-sqlite3": "^12.10.0",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "framer-motion": "^11.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.460.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.0",
    "serialport": "^13.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "usb": "^3.0.1",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "electron": "^41.10.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.shega.inventory",
    "productName": "Shega",
    "win": {
      "target": "nsis",
      "icon": "src/assets/images/logo.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "nat2132",
      "repo": "shega-desktop"
    }
  }
}
